# Where this edge forwards. DSH listens on loopback by default.
DSH_UPSTREAM=127.0.0.1:8898

# Tunnel mode: no public ports; Cloudflare terminates TLS.
# Direct mode: https://dsh.example.com (Caddy obtains TLS; open 80/443).
SITE_ADDRESS=http://:8088

# Protect /mobilevc/. Generate a bcrypt hash:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'
# Keep the hash in single quotes so $ characters survive.
BASIC_AUTH_USER=mobilevc
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_A_REAL_BCRYPT_HASH'

# Browser upload limit (UI itself limits 12 MB/file, 20 MB total).
MAX_UPLOAD=25MB

# Only needed for the tunnel profile.
# Cloudflare Zero Trust -> Networks -> Tunnels -> public hostname
#   service: http://localhost:8088
CF_TUNNEL_TOKEN=
